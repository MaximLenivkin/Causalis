            use_copula=True,
            copula_corr=_corr(2, -0.4),
            seed=SEED,
            beta_y=coefficients,
            alpha_y=0.2,
            sigma_y=0.3,
        )
        if kind == "binary":
            generator = CausalDatasetGenerator(
                theta=0.7, beta_d=np.array([0.1, 0.2, -0.15]), **options
            )
            oracle_names = ["g0", "g1"]
        else:
            generator = MultiCausalDatasetGenerator(
                n_treatments=2,
                theta=[0.0, 0.7],
                beta_d=np.array([0.1, 0.2, -0.15]),
                **options,
            )
            oracle_names = ["g_d_0", "g_d_1"]
