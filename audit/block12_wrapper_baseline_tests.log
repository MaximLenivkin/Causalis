n = 96, split = 0.5, random_state = 731, outcome_type = 'normal'
outcome_params = {'mean': {'A': 0.0, 'B': 0.2}, 'std': 1.0}
confounder_specs = [{'name': 'feature', 'dist': 'normal'}, {'name': 'other', 'dist': 'normal'}]
