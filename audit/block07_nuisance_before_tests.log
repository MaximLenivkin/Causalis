kind = 'binary', role = 'g0', value = -inf

    @pytest.mark.parametrize("value", [np.nan, np.inf, -np.inf])
    @pytest.mark.parametrize("kind,role", [
        ("binary", "g0"), ("binary", "g1"), ("binary", "m"),
        ("multi", "g"), ("multi", "m")])
    def test_cross_fit_storage_rejects_nonfinite_values_even_if_fold_helper_is_bypassed(kind, role, value):
        model = IRM() if kind == "binary" else MultiTreatmentIRM()
        if kind == "binary":
            predictions = dict(g0_hat=np.ones(6), g1_hat=np.ones(6), m_hat=np.full(6, .5))
            predictions[{"g0": "g0_hat", "g1": "g1_hat", "m": "m_hat"}[role]][2] = value
            options = dict(folds=np.arange(6) % 2, feature_importance=None)
        else:
            predictions = dict(g_hat=np.ones((6, 3)), m_hat=np.full((6, 3), 1 / 3))
            predictions["g_hat" if role == "g" else "m_hat"][2, 1] = value
            options = dict(folds=np.arange(6) % 2)
        with pytest.raises(RuntimeError, match="non-finite"):
>           model._store_cross_fitted_predictions(**predictions, **options)

