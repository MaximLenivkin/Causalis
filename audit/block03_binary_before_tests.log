    def _to_1d(arr: Any, *, name: str) -> np.ndarray:
        vec = np.asarray(arr, dtype=float)
        if vec.ndim == 1:
            pass
        elif vec.ndim == 2 and 1 in vec.shape:
            vec = vec.reshape(-1)
        else:
            raise ValueError(f"{name} must be 1D with shape (n,), got shape {vec.shape}.")
        if vec.shape[0] != n:
